        <mxCell id="refute-update" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2667C9;fontColor=#52687C;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="refute" target="update">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="continue" value="&lt;b&gt;预算允许且&lt;br&gt;存在有价值的&lt;br&gt;下一步？&lt;/b&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E8;strokeColor=#AA641B;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=19;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;shape=rhombus;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="180" y="1225" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="update-continue" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AA641B;fontColor=#AA641B;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="update" target="continue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="acquire" value="&lt;b&gt;7  选择下一条高价值证据&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;候选分歧 / 反例 / 边界检验&lt;br&gt;采集前登记探索或确证用途&lt;br&gt;更新可见数据；t ← t + 1&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E8;strokeColor=#AA641B;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="425" width="345" height="150" as="geometry" />
        </mxCell>
        <mxCell id="continue-acquire" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AA641B;fontColor=#AA641B;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="continue" target="acquire">
          <mxGeometry relative="1" as="geometry">
