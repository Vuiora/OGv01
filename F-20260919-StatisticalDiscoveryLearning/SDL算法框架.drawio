        <mxCell id="explore-title" value="D_E  探索集" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#187E77;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="85" y="255" width="450" height="43" as="geometry" />
        </mxCell>
        <mxCell id="explore-body" value="允许：表示学习、模式挖掘、参数拟合&lt;br&gt;允许：内部交叉验证、生成竞争假说&lt;br&gt;&lt;br&gt;产物：固定变换、模型参数、候选结构&lt;br&gt;状态：探索器可见，可随新证据扩充" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#142D45;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
