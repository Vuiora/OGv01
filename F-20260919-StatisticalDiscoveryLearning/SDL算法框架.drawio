        <mxCell id="develop-title" value="D_V  开发评估集" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#AA641B;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
