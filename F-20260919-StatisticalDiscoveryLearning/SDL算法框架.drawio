        <mxCell id="holdout" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2667C9;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1240" y="230" width="500" height="390" as="geometry" />
        </mxCell>
        <mxCell id="holdout-title" value="D_C,t  第 t 轮确证集" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#2667C9;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1265" y="255" width="450" height="43" as="geometry" />
        </mxCell>
        <mxCell id="holdout-body" value="来自封存未见数据，或预定方案的新采样&lt;br&gt;探索器与 LLM 不得读取未解封内容&lt;br&gt;&lt;br&gt;只用于已冻结假说及其固定评估方案&lt;br&gt;产物：效应量、区间、校正证据与结论" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#142D45;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1265" y="320" width="450" height="245" as="geometry" />
        </mxCell>
        <mxCell id="engine" value="&lt;b&gt;探索器：表示 → 模式 → 假说 → 开发评估&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;保留候选版本与数据使用记录；训练拟合的变换在确认前固定。&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#187E77;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=21;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="780" height="120" as="geometry" />
        </mxCell>
        <mxCell id="freeze" value="&lt;b&gt;冻结闸门&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;假说 / 参数 / 预测&lt;br&gt;检验 / 阈值 / 停止规则&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#142D45;strokeColor=#142D45;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=22;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;fontColor=#FFFFFF;align=center;" vertex="1" parent="1">
          <mxGeometry x="895" y="790" width="285" height="120" as="geometry" />
        </mxCell>
        <mxCell id="validator" value="&lt;b&gt;确证执行器：一次有效的独立检验&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;读取已冻结候选；输出支持 / 反驳 / 证据不足&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2667C9;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=21;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1240" y="790" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="explore-engine" value="训练 / 搜索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#187E77;fontColor=#187E77;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="explore" target="engine">
