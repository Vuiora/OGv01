        </mxCell>
        <mxCell id="develop-body" value="允许：比较候选、检查稳定性与泛化&lt;br&gt;反馈可参与后续算法与假说选择&lt;br&gt;&lt;br&gt;产物：开发指标、错误分析、候选排序&lt;br&gt;状态：多轮反馈后不再是独立确证证据" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#142D45;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="675" y="320" width="450" height="245" as="geometry" />
