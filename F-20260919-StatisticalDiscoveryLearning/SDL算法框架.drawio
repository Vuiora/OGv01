        <mxCell id="archive" value="&lt;b&gt;可复现的候选发现&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;假说 + 证据 + 预测 + 适用范围&lt;br&gt;知识库更新 / 外部复现任务&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#187E77;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
