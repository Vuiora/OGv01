        <mxCell id="freeze-validator" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2667C9;fontColor=#2667C9;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="freeze" target="validator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="feedback" value="&lt;b&gt;已见证据进入下一轮探索；修订后的假说重新冻结&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;D_C,t 一旦被查看或用于修订，就标记为“已见”。它可以帮助学习，但不能再次独立确证 H_new。&lt;br&gt;确证 H_new 需要新的 D_C,t+1；主动采集的数据也必须在采集前登记用途和抽样方案。&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E8;strokeColor=#AA641B;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=21;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="1045" width="1120" height="125" as="geometry" />
        </mxCell>
        <mxCell id="validator-feedback" value="结果与反例" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AA641B;fontColor=#AA641B;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="validator" target="feedback">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1200" y="892" />
              <mxPoint x="1200" y="1095" />
