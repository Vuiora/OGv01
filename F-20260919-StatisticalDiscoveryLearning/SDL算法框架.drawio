              <mxPoint x="30" y="1290" />
              <mxPoint x="30" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="acquire-generate" value="新一轮" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AA641B;fontColor=#AA641B;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="acquire" target="generate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="finish" value="&lt;b&gt;停止并交付：发现档案 + 未决问题&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#142D45;strokeColor=#142D45;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=19;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;fontColor=#FFFFFF;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="1435" width="430" height="65" as="geometry" />
        </mxCell>
        <mxCell id="continue-finish" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#AA641B;fontColor=#AA641B;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="continue" target="finish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="empty-candidates" value="无候选：检查预算" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52687C;fontColor=#52687C;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="evaluate" target="continue">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="435" y="627" />
              <mxPoint x="435" y="1190" />
              <mxPoint x="295" y="1190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="budget-note" value="&lt;b&gt;停止条件提前设定&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;计算 / 采样 / 轮次预算耗尽&lt;br&gt;无有价值的候选或下一步&lt;br&gt;达到预定复现目标&lt;br&gt;禁止看普通 p 值后随意停采&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#A9BBCB;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="345" height="175" as="geometry" />
        </mxCell>
        <mxCell id="revision-note" value="&lt;b&gt;假说修订必须可追踪&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;修改变量、参数或适用范围&lt;br&gt;均创建新版本并保留父版本&lt;br&gt;&lt;br&gt;修订假说需要新的确证数据&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#A9BBCB;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="685" width="345" height="190" as="geometry" />
        </mxCell>
        <mxCell id="role-note" value="&lt;b&gt;LLM 与执行器分工&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;LLM：提案、概念、代码草案、修订&lt;br&gt;执行器：运行、计算、检验、审计&lt;br&gt;LLM 不能替代数值证据裁决&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#A9BBCB;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1310" y="230" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="eval-note" value="&lt;b&gt;开发评分不是最终显著性&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;D_E 内部交叉验证 + D_V 开发反馈&lt;br&gt;反复查看 D_V 会影响选择过程&lt;br&gt;最终结论仍需未见的 D_C,t&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3EEFA;strokeColor=#7253A0;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1310" y="440" width="420" height="165" as="geometry" />
        </mxCell>
        <mxCell id="alpha-note" value="&lt;b&gt;每轮显式管理检验预算&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;示例：alpha_t = alpha / 2^t，t ≥ 1&lt;br&gt;批次内 Holm 校正（有效 p 值前提）&lt;br&gt;跨轮预算总和不超过 alpha&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF4FF;strokeColor=#2667C9;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1310" y="665" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="causal-note" value="&lt;b&gt;机制主张需要额外证据&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;仅有关联证据时标记为关联&lt;br&gt;因果主张需识别条件或干预证据&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#A9BBCB;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1310" y="875" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="所有结果均保留：支持、失败与证据不足都进入账本。&lt;br&gt;本图为可实现的研究原型设计；统计结论依赖采样方案、检验假设与数据质量。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#52687C;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="570" y="1432" width="1170" height="62" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
