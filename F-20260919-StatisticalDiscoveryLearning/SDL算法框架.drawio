        <mxCell id="trace" value="&lt;b&gt;贯穿全程：证据账本&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;数据、代码、知识、假说版本&lt;br&gt;记录成功、失败与修订原因&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#A9BBCB;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
