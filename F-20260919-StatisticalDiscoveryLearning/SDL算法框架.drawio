  <diagram id="page-2" name="02 算法主循环">
    <mxGraphModel dx="1800" dy="1550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1550" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="canvas" value="" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1800" height="1550" as="geometry" />
        </mxCell>
        <mxCell id="eyebrow" value="SDL  /  STATISTICAL DISCOVERY LEARNING  /  FRAMEWORK v0.1  /  02" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#2667C9;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1680" height="25" as="geometry" />
        </mxCell>
        <mxCell id="title" value="SDL 主循环：生成 → 竞争 → 确证 → 修订" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=33;fontColor=#142D45;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="65" width="1680" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="输入：观测 D、知识 K、任务 T、约束 C、预算 B；输出：带证据等级和版本的发现档案。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#52687C;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1680" height="32" as="geometry" />
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;初始化轮次 t = 1、假说池 H、证据账本 E&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#142D45;strokeColor=#142D45;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=20;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;fontColor=#FFFFFF;align=center;" vertex="1" parent="1">
          <mxGeometry x="550" y="180" width="620" height="65" as="geometry" />
        </mxCell>
        <mxCell id="protocol" value="&lt;b&gt;1  建立数据与任务协议&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;划分 D_E / D_V / D_C,t；设定基线、预算和可检验的目标&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF4FF;strokeColor=#2667C9;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="550" y="290" width="620" height="90" as="geometry" />
        </mxCell>
        <mxCell id="generate" value="&lt;b&gt;2  构造表示、搜索模式、生成竞争假说&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;仅用可见资料；加入零假说与替代解释；记录生成来源&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#187E77;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="550" y="425" width="620" height="105" as="geometry" />
        </mxCell>
        <mxCell id="evaluate" value="&lt;b&gt;3  执行检查与开发评估，保留 Pareto 候选&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;评估预测增益、稳定性、复杂度和新颖性；不合格者淘汰&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3EEFA;strokeColor=#7253A0;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="550" y="575" width="620" height="105" as="geometry" />
        </mxCell>
        <mxCell id="freeze" value="&lt;b&gt;4  冻结候选批次 H_t 与确证计划&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;锁定特征变换、参数、预测、检验族、阈值及样本停止规则&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF4FF;strokeColor=#2667C9;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="550" y="725" width="620" height="105" as="geometry" />
        </mxCell>
        <mxCell id="confirm" value="&lt;b&gt;5  对 D_C,t 执行一次有效的独立确证&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;输出效应量、区间及校正证据；记录 alpha_t 使用情况&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF4FF;strokeColor=#2667C9;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="550" y="875" width="620" height="110" as="geometry" />
        </mxCell>
        <mxCell id="start-next" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2667C9;fontColor=#52687C;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="protocol">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="protocol-next" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2667C9;fontColor=#52687C;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="protocol" target="generate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="generate-next" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2667C9;fontColor=#52687C;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="generate" target="evaluate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="evaluate-next" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2667C9;fontColor=#52687C;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="evaluate" target="freeze">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="freeze-next" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2667C9;fontColor=#52687C;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="freeze" target="confirm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="support" value="&lt;b&gt;支持&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;达到预设证据与效应要求&lt;br&gt;记录范围；安排必要复现&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#187E77;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="470" y="1055" width="300" height="105" as="geometry" />
        </mxCell>
        <mxCell id="inconclusive" value="&lt;b&gt;证据不足&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;未显著 / 区间过宽 / 样本不足&lt;br&gt;不能解释为假说成立&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E8;strokeColor=#AA641B;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="780" y="1055" width="320" height="105" as="geometry" />
        </mxCell>
        <mxCell id="refute" value="&lt;b&gt;反驳或不相容&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;有效反例或预设反向证据&lt;br&gt;淘汰、限缩范围或修订&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#AA4D53;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1055" width="320" height="105" as="geometry" />
        </mxCell>
        <mxCell id="confirm-support" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2667C9;fontColor=#52687C;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="confirm" target="support">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="1020" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="confirm-inconclusive" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2667C9;fontColor=#52687C;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="confirm" target="inconclusive">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="1020" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="confirm-refute" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2667C9;fontColor=#52687C;fontFamily=Microsoft YaHei;fontSize=16;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="confirm" target="refute">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="1020" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="update" value="&lt;b&gt;6  更新知识、假说状态与证据账本&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#52687C&quot;&gt;已见确证数据转为后续可见资料&lt;br&gt;修订产生 H_new；不得复用旧确证证据&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#A9BBCB;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="710" y="1230" width="500" height="110" as="geometry" />
