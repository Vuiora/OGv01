        <mxCell id="develop" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF5E8;strokeColor=#AA641B;fontColor=#142D45;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=18;strokeWidth=1.5;" vertex="1" parent="1">
