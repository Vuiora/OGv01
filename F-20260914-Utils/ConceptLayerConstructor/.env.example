# Copy to .env; never commit real secrets.
CLC_LLM_BASE_URL=https://api.openai.com/v1
CLC_LLM_API_KEY=
# Set a model available from your provider, supporting chat/completions + JSON output.
CLC_LLM_MODEL=
CLC_LLM_JSON_MODE=true
CLC_API_KEY=
CLC_DATA_DIR=./data
CLC_MAX_UPLOAD_MB=40
CLC_MAX_PAGES=300
CLC_MAX_SOURCE_CHARS=400000
CLC_CHUNK_CHARS=7000
CLC_MAX_CHUNKS=80
CLC_MAX_CONCEPTS=300
CLC_JOB_TIMEOUT=3600
# Optional TTF font with Chinese glyphs. Container path must be mounted separately.
# CLC_PDF_FONT=/fonts/chinese.ttf
N8N_ENCRYPTION_KEY=
# Set a tested release tag or image digest before deployment.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:stable

