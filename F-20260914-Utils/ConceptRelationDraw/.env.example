# OpenAI official GPT API. This model is an example, not a claim of latest availability.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1
# responses = OpenAI Responses API; chat = compatible Chat Completions APIs.
LLM_API_STYLE=responses
LLM_JSON_MODE=true
LLM_TIMEOUT=180
LLM_OUTPUT_TOKENS=8192
# Optional. Leave empty to use provider defaults; only set a value supported by your model.
LLM_REASONING_EFFORT=
# Character budgets include complete prompt, not just original Markdown.
# Set conservatively for your provider's context window, especially Chinese text.
MAX_DOCUMENT_CHARS=60000
MAX_PROMPT_CHARS=100000
MAX_CONCEPTS=250
MAX_KEY_CONCEPTS=20
MAX_RELATIONS_PER_CONCEPT=3
CHUNK_CHARS=5000
RELATION_BATCH_SIZE=12
MAX_UPLOAD_MB=30
DATA_ROOT=./data
APP_API_KEY=
DOCLING_BASE_URL=http://127.0.0.1:5002
DOCLING_API_KEY=
N8N_WEBHOOK_URL=http://127.0.0.1:5679/webhook/concept-relation
N8N_ENCRYPTION_KEY=
