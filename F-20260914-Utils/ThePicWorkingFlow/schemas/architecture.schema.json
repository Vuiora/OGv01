{
  "$defs": {
    "Component": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "role": {
          "default": "component",
          "enum": [
            "component",
            "group",
            "plda",
            "core",
            "data"
          ],
          "title": "Role",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 10,
          "title": "Evidence",
          "type": "array"
        },
        "status": {
          "default": "observed",
          "enum": [
            "observed",
            "proposed",
            "external"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "module"
      ],
      "title": "Component",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "enum": [
            "raw",
            "standard",
            "analysis",
            "dispatch",
            "result",
            "control"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 60,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "kind"
      ],
      "title": "Connection",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "device",
            "infrastructure",
            "data"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "title": "Region",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "title": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "modules": {
      "items": {
        "$ref": "#/$defs/Region"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Modules",
      "type": "array"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "maxItems": 80,
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "connections": {
      "items": {
        "$ref": "#/$defs/Connection"
      },
      "maxItems": 120,
      "title": "Connections",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Assumptions",
      "type": "array"
    }
  },
  "required": [
    "title",
    "modules",
    "components"
  ],
  "title": "Architecture",
  "type": "object"
}
