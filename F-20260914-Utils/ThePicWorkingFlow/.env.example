# Compatible chat-completions endpoint; include /v1 when your provider uses it.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
ANALYSIS_MODEL=
DESIGN_MODEL=
# Optional independent provider overrides (empty means use common settings).
ANALYSIS_BASE_URL=
ANALYSIS_API_KEY=
DESIGN_BASE_URL=
DESIGN_API_KEY=
LLM_JSON_MODE=true

# scripts/init-env.ps1 creates random local values for these three keys.
APP_API_KEY=
DOCLING_API_KEY=
N8N_ENCRYPTION_KEY=

# Defaults below are for local Python development; Compose overrides them.
INPUT_ROOT=..
DRAWIO_TEMPLATE=../TheStructure.drawio
DATA_ROOT=./data
DOCLING_BASE_URL=http://127.0.0.1:5001
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/drawio-architecture
NO_PROXY=localhost,127.0.0.1,architecture-api,docling,n8n
